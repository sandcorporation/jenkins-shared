#!/usr/bin/env bash
# deploy.sh 시험용 가짜 docker. 부른 명령을 $FAKE_LOG 에 적고, 서비스가 어떤 이미지로 떴는지 $FAKE_STATE 에 남긴다.
#   FAKE_IMAGE_VAR    compose 가 읽는 이미지 변수 이름(기본 APP_IMAGE)
#   FAKE_BAD_HEALTH   이 글자를 담은 이미지가 web 이면 헬스 명령이 실패
#   FAKE_UNHEALTHY    이 글자를 담은 이미지가 web 이면 healthy 가 안 됨
#   FAKE_PULL_FAIL    이 글자를 담은 이미지 pull 이 실패
#   FAKE_MIGRATE_FAIL 비어 있지 않으면 migrate 가 실패
set -u
echo "docker $*" >> "$FAKE_LOG"
var="${FAKE_IMAGE_VAR:-APP_IMAGE}"
current() { grep "^$1=" "$FAKE_STATE" 2>/dev/null | tail -n 1 | cut -d= -f2-; }
has() { [ -n "$2" ] && case "$1" in *"$2"*) return 0 ;; esac; return 1; }

case "$1" in
  pull)
    has "$2" "${FAKE_PULL_FAIL:-}" && { echo "pull 실패 $2" >&2; exit 1; }
    exit 0 ;;
  inspect)
    has "$(current web)" "${FAKE_UNHEALTHY:-}" && { echo unhealthy; exit 0; }
    echo healthy; exit 0 ;;
  image) exit 0 ;;
  compose) shift ;;
  *) exit 0 ;;
esac

case "$1" in
  config) printf 'web\nworker\nrenderer\n'; exit 0 ;;
  ps) [ "${2:-}" = "-q" ] && echo "cid-${3:-}"; exit 0 ;;
  logs) exit 0 ;;
  run)
    case "$*" in *migrate*) [ -n "${FAKE_MIGRATE_FAIL:-}" ] && exit 1 ;; esac
    exit 0 ;;
  up)
    s="${*: -1}"
    echo "$s=${!var:-}" >> "$FAKE_STATE"
    exit 0 ;;
  exec)
    has "$(current web)" "${FAKE_BAD_HEALTH:-}" && { echo "health 500" >&2; exit 1; }
    echo '{"status":"ok"}'; exit 0 ;;
esac
exit 0
