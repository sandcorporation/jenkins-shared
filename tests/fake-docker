#!/usr/bin/env bash
# deploy.sh 시험용 가짜 docker. 부른 명령을 $FAKE_LOG 에 적고, 서비스가 어떤 이미지로 떴는지 $FAKE_STATE 에 남긴다.
#   FAKE_IMAGE_VAR    compose 가 읽는 이미지 변수 이름(기본 APP_IMAGE)
#   FAKE_BAD_HEALTH   이 글자를 담은 이미지가 web 이면 헬스 명령이 실패
#   FAKE_UNHEALTHY    이 글자를 담은 이미지가 web 이면 healthy 가 안 됨
#   FAKE_PULL_FAIL    이 글자를 담은 이미지 pull 이 실패
#   FAKE_MIGRATE_FAIL 비어 있지 않으면 migrate 가 실패
#   FAKE_RUNNING      "서비스=이미지문자열 ..." 떠 있는 컨테이너(compose ps --status running 이 이것만 돌려준다)
#   FAKE_WANT         "서비스=이미지문자열 ..." compose config --images 가 돌려줄 값(없으면 FAKE_RUNNING 값)
#   FAKE_IMAGE_IDS    "이미지문자열=ID ..." 로컬 이미지 ID(없는 문자열은 image inspect 실패 — 로컬에 없음)
#   FAKE_DEF          compose 정의(image 말고)의 이름(기본 def1). 컨테이너 라벨은 언제나 def1:<컨테이너 이미지문자열>
set -u
echo "docker $*" >> "$FAKE_LOG"
var="${FAKE_IMAGE_VAR:-APP_IMAGE}"
current() { grep "^$1=" "$FAKE_STATE" 2>/dev/null | tail -n 1 | cut -d= -f2-; }
lookup() { local p; for p in $2; do [ "${p%%=*}" = "$1" ] && { printf '%s\n' "${p#*=}"; return 0; }; done; return 1; }
cid_svc() { printf '%s\n' "${1#cid-}"; }
has() { [ -n "$2" ] && case "$1" in *"$2"*) return 0 ;; esac; return 1; }

case "$1" in
  pull)
    has "$2" "${FAKE_PULL_FAIL:-}" && { echo "pull 실패 $2" >&2; exit 1; }
    exit 0 ;;
  inspect)
    fmt="${3:-}" c="${4:-}"
    case "$fmt" in
      *Config.Image*) lookup "$(cid_svc "$c")" "${FAKE_RUNNING:-}"; exit ;;
      *config-hash*) echo "def1:$(lookup "$(cid_svc "$c")" "${FAKE_RUNNING:-}")"; exit 0 ;;
      '{{.Image}}') lookup "$(lookup "$(cid_svc "$c")" "${FAKE_RUNNING:-}")" "${FAKE_IMAGE_IDS:-}"; exit 0 ;;
    esac
    has "$(current web)" "${FAKE_UNHEALTHY:-}" && { echo unhealthy; exit 0; }
    echo healthy; exit 0 ;;
  image)
    [ "${2:-}" = inspect ] && { lookup "${5:-}" "${FAKE_IMAGE_IDS:-}" || { echo "no such image ${5:-}" >&2; exit 1; }; }
    exit 0 ;;
  compose) shift ;;
  *) exit 0 ;;
esac

case "$1" in
  config)
    case "${2:-}" in
      --images) lookup "$3" "${FAKE_WANT:-}" || lookup "$3" "${FAKE_RUNNING:-}"; exit 0 ;;
      --hash)
        # image 는 COMPOSE_FILE 마지막 파일(override)에 있으면 그것, 없으면 compose 가 원하는 문자열
        echo "config --hash COMPOSE_FILE=${COMPOSE_FILE:-}" >> "$FAKE_LOG"
        ov="${COMPOSE_FILE##*:}"
        img=$(sed -n 's/^ *image: "\(.*\)"$/\1/p' "$ov" 2>/dev/null)
        [ -n "$img" ] || img=$(lookup "$3" "${FAKE_WANT:-}")
        echo "$3 ${FAKE_DEF:-def1}:$img"; exit 0 ;;
    esac
    printf 'web\nworker\nrenderer\ndb\n'; exit 0 ;;
  ps)
    if [ "${2:-}" = "-q" ] && [ "${3:-}" = "--status" ]; then
      lookup "${5:-}" "${FAKE_RUNNING:-}" >/dev/null && echo "cid-${5:-}"
      exit 0
    fi
    [ "${2:-}" = "-q" ] && echo "cid-${3:-}"; exit 0 ;;
  logs) exit 0 ;;
  run)
    case "$*" in *migrate*) [ -n "${FAKE_MIGRATE_FAIL:-}" ] && exit 1 ;; esac
    exit 0 ;;
  up)
    s="${*: -1}"
    echo "$s=${!var:-}" >> "$FAKE_STATE"
    exit 0 ;;
  exec)
    has "$(current web)" "${FAKE_BAD_HEALTH:-}" && { echo "health 500" >&2; exit 1; }
    echo '{"status":"ok"}'; exit 0 ;;
esac
exit 0
